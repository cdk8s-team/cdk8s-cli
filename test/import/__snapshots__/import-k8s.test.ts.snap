        },
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.core.v1.PodSecurityContext#fsGroupChangePolicy",
            },
            "remarks": "This field will only apply to volume types which support fsGroup based ownership(and permissions). It will have no effect on ephemeral volume types such as: secret, configmaps and emptydir. Valid values are "OnRootMismatch" and "Always". If not specified, "Always" is used.",
            "summary": "fsGroupChangePolicy defines behavior of changing ownership and permission of the volume before being exposed inside Pod.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 21452,
          },
          "name": "fsGroupChangePolicy",
          "optional": true,
