            },
            "remarks": "This condition should be set to true for a ready endpoint that is terminating. If nil, consumers should defer to the ready condition. This field can be enabled with the EndpointSliceTerminatingCondition feature gate.",
            "summary": "serving is identical to ready except that it is set regardless of the terminating state of endpoints.",
          },
          "immutable": true,
