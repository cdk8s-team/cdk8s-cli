          "docs": {
            "custom": {
              "schema": "io.k8s.api.node.v1alpha1.RuntimeClassSpec#runtimeHandler",
            },
            "remarks": "The possible values are specific to the node & CRI configuration.  It is assumed that all handlers are available on every node, and handlers of the same name are equivalent on every node. For example, a handler called "runc" might specify that the runc OCI runtime (using native Linux containers) will be used to run the containers in a pod. The RuntimeHandler must conform to the DNS Label (RFC 1123) requirements and is immutable.",
            "summary": "RuntimeHandler specifies the underlying runtime and configuration that the CRI implementation will use to handle pods of this class.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 21946,
          },
          "name": "runtimeHandler",
          "type": {
