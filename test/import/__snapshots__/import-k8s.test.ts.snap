            },
            "default": "false. More info: https://kubernetes.io/docs/concepts/storage/volumes#gcepersistentdisk",
            "remarks": "Defaults to false. More info: https://kubernetes.io/docs/concepts/storage/volumes#gcepersistentdisk",
