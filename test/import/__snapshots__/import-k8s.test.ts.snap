      "docs": {
        "custom": {
          "schema": "io.k8s.api.core.v1.NodeAffinity",
        },
        "summary": "Node affinity is a group of node affinity scheduling rules.",
      },
      "fqn": "k8s.NodeAffinity",
      "kind": "interface",
      "locationInModule": {
        "filename": "k8s.ts",
