    "k8s.ResourcePolicyRuleV1Alpha1": {
      "assembly": "k8s",
      "datatype": true,
      "docs": {
        "custom": {
          "schema": "io.k8s.api.flowcontrol.v1alpha1.ResourcePolicyRule",
        },
        "remarks": "A ResourcePolicyRule matches a resource request if and only if: (a) at least one member of verbs matches the request, (b) at least one member of apiGroups matches the request, (c) at least one member of resources matches the request, and (d) least one member of namespaces matches the request.",
        "summary": "ResourcePolicyRule is a predicate that matches some resource requests, testing the request's verb and the target resource.",
      },
      "fqn": "k8s.ResourcePolicyRuleV1Alpha1",
      "kind": "interface",
      "locationInModule": {
        "filename": "k8s.ts",
        "line": 31319,
      },
      "name": "ResourcePolicyRuleV1Alpha1",
      "properties": [
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.flowcontrol.v1alpha1.ResourcePolicyRule#apiGroups",
            },
            "remarks": ""*" matches all API groups and, if present, must be the only entry. Required.",
            "summary": "\`apiGroups\` is a list of matching API groups and may not be empty.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 31325,
          },
          "name": "apiGroups",
          "type": {
            "collection": {
              "elementtype": {
                "primitive": "string",
              },
              "kind": "array",
            },
          },
        },
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.flowcontrol.v1alpha1.ResourcePolicyRule#resources",
            },
            "summary": "\`resources\` is a list of matching resources (i.e., lowercase and plural) with, if desired, subresource.  For example, [ "services", "nodes/status" ].  This list may not be empty. "*" matches all resources and, if present, must be the only entry. Required.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 31346,
          },
          "name": "resources",
          "type": {
            "collection": {
              "elementtype": {
                "primitive": "string",
              },
              "kind": "array",
            },
          },
        },
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.flowcontrol.v1alpha1.ResourcePolicyRule#verbs",
            },
            "remarks": ""*" matches all verbs and, if present, must be the only entry. Required.",
            "summary": "\`verbs\` is a list of matching verbs and may not be empty.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 31353,
          },
          "name": "verbs",
          "type": {
            "collection": {
              "elementtype": {
                "primitive": "string",
              },
              "kind": "array",
            },
          },
        },
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.flowcontrol.v1alpha1.ResourcePolicyRule#clusterScope",
            },
            "remarks": "If this field is omitted or false then the \`namespaces\` field must contain a non-empty list.",
            "summary": "\`clusterScope\` indicates whether to match requests that do not specify a namespace (which happens either because the resource is not namespaced or the request targets all namespaces).",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 31332,
          },
          "name": "clusterScope",
          "optional": true,
          "type": {
            "primitive": "boolean",
          },
        },
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.flowcontrol.v1alpha1.ResourcePolicyRule#namespaces",
            },
            "remarks": "A request that specifies a target namespace matches only if either (a) this list contains that target namespace or (b) this list contains "*".  Note that "*" matches any specified namespace but does not match a request that _does not specify_ a namespace (see the \`clusterScope\` field for that). This list may be empty, but only if \`clusterScope\` is true.",
            "summary": "\`namespaces\` is a list of target namespaces that restricts matches.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 31339,
          },
          "name": "namespaces",
          "optional": true,
          "type": {
            "collection": {
              "elementtype": {
                "primitive": "string",
              },
              "kind": "array",
            },
          },
        },
      ],
      "symbolId": "k8s:ResourcePolicyRuleV1Alpha1",
    },
