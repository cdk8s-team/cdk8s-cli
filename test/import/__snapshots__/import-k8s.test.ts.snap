          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.core.v1.ServicePort#appProtocol",
            },
            "remarks": "This field follows standard Kubernetes label syntax. Un-prefixed names are reserved for IANA standard service names (as per RFC-6335 and http://www.iana.org/assignments/service-names). Non-standard protocols should use prefixed names such as mycompany.com/my-custom-protocol. This is a beta field that is guarded by the ServiceAppProtocol feature gate and enabled by default.",
