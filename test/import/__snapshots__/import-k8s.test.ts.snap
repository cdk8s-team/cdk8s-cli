            },
            "remarks": "These endpoints should be considered safe for load balancers and clients to utilize.",
            "summary": "IP addresses which offer the related ports that are marked as ready.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
