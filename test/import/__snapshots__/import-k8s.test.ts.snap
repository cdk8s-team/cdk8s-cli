            "custom": {
              "schema": "io.k8s.api.node.v1alpha1.RuntimeClassSpec#overhead",
            },
            "remarks": "For more details, see https://git.k8s.io/enhancements/keps/sig-node/688-pod-overhead/README.md This field is beta-level as of Kubernetes v1.18, and is only honored by servers that enable the PodOverhead feature.",
            "summary": "Overhead represents the resource overhead associated with running a pod for a given RuntimeClass.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 16931,
          },
          "name": "overhead",
