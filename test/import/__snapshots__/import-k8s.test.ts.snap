            },
            "remarks": "At least one policy must be specified, otherwise the HPAScalingRules will be discarded as invalid",
            "summary": "policies is a list of potential scaling polices which can be used during scaling.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
