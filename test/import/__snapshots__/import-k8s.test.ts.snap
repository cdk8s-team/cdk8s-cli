            "remarks": "Required when \`strategy\` is set to \`Webhook\`.",
            "summary": "webhook describes how to call the conversion webhook.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 29043,
          },
          "name": "webhook",
          "optional": true,
          "type": {
