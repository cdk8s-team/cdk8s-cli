        "custom": {
          "schema": "io.k8s.api.node.v1alpha1.RuntimeClassSpec",
        },
        "remarks": "It contains parameters that are required to describe the RuntimeClass to the Container Runtime Interface (CRI) implementation, as well as any other components that need to understand how the pod will be run. The RuntimeClassSpec is immutable.",
        "summary": "RuntimeClassSpec is a specification of a RuntimeClass.",
      },
      "fqn": "k8s.RuntimeClassSpecV1Alpha1",
      "kind": "interface",
      "locationInModule": {
        "filename": "k8s.ts",
        "line": 20582,
      },
      "name": "RuntimeClassSpecV1Alpha1",
      "properties": [
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.node.v1alpha1.RuntimeClassSpec#runtimeHandler",
            },
            "remarks": "The possible values are specific to the node & CRI configuration.  It is assumed that all handlers are available on every node, and handlers of the same name are equivalent on every node. For example, a handler called "runc" might specify that the runc OCI runtime (using native Linux containers) will be used to run the containers in a pod. The RuntimeHandler must be lowercase, conform to the DNS Label (RFC 1123) requirements, and is immutable.",
            "summary": "RuntimeHandler specifies the underlying runtime and configuration that the CRI implementation will use to handle pods of this class.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 20595,
          },
          "name": "runtimeHandler",
          "type": {
            "primitive": "string",
          },
        },
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.node.v1alpha1.RuntimeClassSpec#overhead",
            },
            "remarks": "For more details, see https://git.k8s.io/enhancements/keps/sig-node/20190226-pod-overhead.md This field is alpha-level as of Kubernetes v1.15, and is only honored by servers that enable the PodOverhead feature.",
            "summary": "Overhead represents the resource overhead associated with running a pod for a given RuntimeClass.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 20588,
          },
          "name": "overhead",
          "optional": true,
          "type": {
            "fqn": "k8s.OverheadV1Alpha1",
          },
        },
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.node.v1alpha1.RuntimeClassSpec#scheduling",
            },
            "remarks": "If scheduling is nil, this RuntimeClass is assumed to be supported by all nodes.",
            "summary": "Scheduling holds the scheduling constraints to ensure that pods running with this RuntimeClass are scheduled to nodes that support it.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 20602,
          },
          "name": "scheduling",
          "optional": true,
          "type": {
            "fqn": "k8s.SchedulingV1Alpha1",
          },
        },
      ],
      "symbolId": "k8s:RuntimeClassSpecV1Alpha1",
    },
