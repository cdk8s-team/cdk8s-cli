   * @default false. More info: https://examples.k8s.io/volumes/glusterfs/README.md#create-a-pod
   * @schema io.k8s.api.core.v1.GlusterfsPersistentVolumeSource#readOnly
   */
  readonly readOnly?: boolean;
}

