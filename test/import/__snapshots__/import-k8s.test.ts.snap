          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.apiextensions-apiserver.pkg.apis.apiextensions.v1.JSONSchemaProps#x-kubernetes-int-or-string",
            },
            "remarks": "If this is true, an empty type is allowed and type as child of anyOf is permitted if following one of the following patterns:

1) anyOf:
- type: integer
- type: string
2) allOf:
- anyOf:
- type: integer
- type: string
- ... zero or more",
            "summary": "x-kubernetes-int-or-string specifies that this value is either an integer or a string.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 34472,
          },
          "name": "xKubernetesIntOrString",
          "optional": true,
