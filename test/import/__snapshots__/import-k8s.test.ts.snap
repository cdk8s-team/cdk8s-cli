          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.apiextensions-apiserver.pkg.apis.apiextensions.v1beta1.CustomResourceConversion#strategy",
            },
            "remarks": "Allowed values are: - \`None\`: The converter only change the apiVersion and would not touch any other field in the custom resource. - \`Webhook\`: API Server will call to an external webhook to do the conversion. Additional information
is needed for this option. This requires spec.preserveUnknownFields to be false, and spec.conversion.webhookClientConfig to be set.",
            "summary": "strategy specifies how custom resources are converted between versions.",
          },
          "immutable": true,
          "locationInModule": {
