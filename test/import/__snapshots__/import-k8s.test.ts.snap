        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.core.v1.EphemeralContainer#args",
            },
            "remarks": "The docker image's CMD is used if this is not provided. Variable references $(VAR_NAME) are expanded using the container's environment. If a variable cannot be resolved, the reference in the input string will be unchanged. Double $$ are reduced to a single $, which allows for escaping the $(VAR_NAME) syntax: i.e. "$$(VAR_NAME)" will produce the string literal "$(VAR_NAME)". Escaped references will never be expanded, regardless of whether the variable exists or not. Cannot be updated. More info: https://kubernetes.io/docs/tasks/inject-data-application/define-command-argument-container/#running-a-command-in-a-shell",
            "summary": "Arguments to the entrypoint.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 21167,
          },
          "name": "args",
          "optional": true,
          "type": {
            "collection": {
              "elementtype": {
                "primitive": "string",
