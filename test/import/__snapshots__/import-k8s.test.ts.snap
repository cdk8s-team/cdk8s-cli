            "default": "TCP.",
            "remarks": "Supports "TCP", "UDP", and "SCTP". Default is TCP.",
            "summary": "The IP protocol for this port.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 26411,
          },
          "name": "protocol",
          "optional": true,
