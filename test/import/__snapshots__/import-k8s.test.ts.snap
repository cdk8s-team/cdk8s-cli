    "k8s.LimitedPriorityLevelConfigurationV1Beta1": {
      "assembly": "k8s",
      "datatype": true,
      "docs": {
        "custom": {
          "schema": "io.k8s.api.flowcontrol.v1beta1.LimitedPriorityLevelConfiguration",
        },
        "remarks": "It addresses two issues:
* How are requests for this priority level limited?
* What should be done with requests that exceed the limit?",
        "summary": "LimitedPriorityLevelConfiguration specifies how to handle requests that are subject to limits.",
      },
      "fqn": "k8s.LimitedPriorityLevelConfigurationV1Beta1",
      "kind": "interface",
      "locationInModule": {
        "filename": "k8s.ts",
        "line": 22302,
      },
      "name": "LimitedPriorityLevelConfigurationV1Beta1",
      "properties": [
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.flowcontrol.v1beta1.LimitedPriorityLevelConfiguration#assuredConcurrencyShares",
            },
            "remarks": "ACS must be a positive number. The server's concurrency limit (SCL) is divided among the concurrency-controlled priority levels in proportion to their assured concurrency shares. This produces the assured concurrency value (ACV) --- the number of requests that may be executing at a time --- for each such priority level:

ACV(l) = ceil( SCL * ACS(l) / ( sum[priority levels k] ACS(k) ) )

bigger numbers of ACS mean more reserved concurrent requests (at the expense of every other PL). This field has a default value of 30.",
            "summary": "\`assuredConcurrencyShares\` (ACS) configures the execution limit, which is a limit on the number of requests of this priority level that may be exeucting at a given time.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 22312,
          },
          "name": "assuredConcurrencyShares",
          "optional": true,
          "type": {
            "primitive": "number",
          },
        },
        {
          "abstract": true,
          "docs": {
            "custom": {
              "schema": "io.k8s.api.flowcontrol.v1beta1.LimitedPriorityLevelConfiguration#limitResponse",
            },
            "summary": "\`limitResponse\` indicates what to do with requests that can not be executed right now.",
          },
          "immutable": true,
          "locationInModule": {
            "filename": "k8s.ts",
            "line": 22319,
          },
          "name": "limitResponse",
          "optional": true,
          "type": {
            "fqn": "k8s.LimitResponseV1Beta1",
          },
        },
      ],
      "symbolId": "k8s:LimitedPriorityLevelConfigurationV1Beta1",
    },
