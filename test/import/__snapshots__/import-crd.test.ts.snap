        "remarks": "This defaults to the default PodSecurityContext.",
        "summary": "SecurityContext holds pod-level security attributes and common container settings.",
      },
      "fqn": "monitoringcoreoscom.PrometheusV1SpecSecurityContext",
      "kind": "interface",
