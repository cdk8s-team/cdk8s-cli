        },
        "summary": "Describes node affinity scheduling rules for the pod.",
      },
      "fqn": "cert-managerio.ClusterIssuerV1SpecAcmeSolversHttp01IngressPodTemplateSpecAffinityNodeAffinity",
      "kind": "interface",
      "locationInModule": Object {
