        },
        "summary": "Describes node affinity scheduling rules for the pod.",
      },
      "fqn": "monitoringcoreoscom.PrometheusV1SpecAffinityNodeAffinity",
      "kind": "interface",
      "locationInModule": Object {
        "filename": "monitoring.coreos.com.ts",
