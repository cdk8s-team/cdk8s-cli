          "abstract": true,
          "docs": Object {
            "custom": Object {
              "schema": "CertificateV1SpecPrivateKey#size",
            },
            "remarks": "If \`algorithm\` is set to \`RSA\`, valid values are \`2048\`, \`4096\` or \`8192\`, and will default to \`2048\` if not specified. If \`algorithm\` is set to \`ECDSA\`, valid values are \`256\`, \`384\` or \`521\`, and will default to \`256\` if not specified. If \`algorithm\` is set to \`Ed25519\`, Size is ignored. No other values are allowed.",
            "summary": "Size is the key bit size of the corresponding private key for this certificate.",
