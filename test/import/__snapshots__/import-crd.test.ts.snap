            },
            "remarks": "Optionally, a \`key\` may be specified to select a specific entry within the named Secret resource. If \`key\` is not specified, a default of \`tls.key\` will be used.",
            "summary": "PrivateKey is the name of a Kubernetes Secret resource that will be used to store the automatically generated ACME account private key.",
          },
          "immutable": true,
          "locationInModule": Object {
            "filename": "cert-manager.io.ts",
